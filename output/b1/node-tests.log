ul:after{border-top-color:rgba(18,26,38,.95)}\n.bub.boss{background:rgba(38,12,10,.96);border-color:var(--primary);width:min(34vw,400px)}\n.bub.boss:after{border-top-color:rgba(38,12,10,.96)}\n.bub .line{color:var(--muted-foreground);padding:1px 0}\n.bub .line.truth{color:var(--gold)} .bub .line.confess{color:var(--warning)}\n.bub .line.false{color:var(--destructive)}\n\n.mark.speech-side .bub{bottom:-8px;left:38px;transform:none}\n.mark.speech-side .bub:after{left:-8px;bottom:12px;margin:0;border:8px solid transparent;border-right-color:rgba(24,11,17,.96);border-left:0;border-top-color:transparent}\n.mark.speech-side.aR .bub{left:auto;right:38px;transform:none}\n.mark.speech-side.aR .bub:after{left:auto;right:-8px;border-right:0;border-left:8px solid rgba(24,11,17,.96)}\n.mark.speech-side.soul .bub{font-size:10px;line-height:1.45;width:min(26vw,280px)}\n#ov .repairfab[data-target="nira"]{z-index:10;white-space:nowrap}\n/* ---------- แถบบัญชาการเหนือฉาก ----------\n   เดิมแผงนี้ลอยทับกลางฉากจนมองแผนที่ไม่เห็น ย้ายมาอยู่เหนือฉากเป็นแถบเต็มความกว้าง */\n/* ---------- แถบโค้ช: สอนทีละเรื่อง ----------\n   เดิมมีแต่โมดัล "วิธีเล่น" ที่เทสิบสามข้อพร้อมกัน เจ้าของบอกว่าดูยากไป (7 ก.ย. 2569) */\n/* ย้ายมาอยู่ล่างสุดของหน้า 8 ก.ย. 2569 — เดิมอยู่ใต้หัวเรื่อง\n   ทุกครั้งที่มีบทใหม่ มันดันแถบบัญชาการกับฉากเลื่อนลงไปทั้งแผง จนคลิกผิดที่ */\n.coach{background:linear-gradient(90deg,var(--accent),var(--card));\n  border:1px solid var(--gold);border-left-width:4px;border-radius:var(--radius);\n  padding:var(--space-3) var(--space-4);display:flex;gap:var(--space-3);align-items:flex-start;\n  margin-top:auto}\n.coach .txt{min-width:0;flex:1}\n.coach b{color:var(--gold);font-family:var(--font-display);font-size:1.05rem;display:block;margin-bottom:2px}\n.coach p{margin:0;font-size:var(--text-sm);line-height:var(--leading-body)}\n.coach .tip{margin-top:6px;font-size:var(--text-xs);color:var(--accent-foreground)}\n.coach .step{font-size:var(--text-xs);color:var(--muted-foreground);white-space:nowrap}\n.coach button{flex-shrink:0}\n\n/* ชิปทรัพยากรกดได้ทุกอัน — กดแล้วบอกว่าแถบนั้นมีไว้ทำอะไร หมดแล้วเกิดอะไร */\n.chip.tap{cursor:pointer;border-color:var(-`... 169815 more characters,
