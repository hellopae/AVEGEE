ent(1200px 700px at 50% -10%,#2a1016 0%,var(--background) 60%);\n  color:var(--foreground); font-family:var(--font-sans); font-size:var(--text-base);\n  -webkit-font-smoothing:antialiased;\n}\n/* ---------- ข้อ D ชุด 15 — .wrap เป็นเปลือกเกมเต็มจอ (แทนหน้าเว็บเลื่อนแบบเดิม) ----------\n   เคารพ safe-area (รอยบาก/แถบโฮมมือถือ) ตามกติกา portrait-first */\n.wrap{position:fixed;inset:0;display:flex;flex-direction:column;\n  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);\n  background:#0b0508;overflow:hidden}\n\n/* ---------- แถบทรัพยากรเดิม (เหลือไว้ให้ header ใน legacy-drawer ใช้) ---------- */\nheader{display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap}\n#ava{object-fit:cover;object-position:center top;\n  background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:2px}\nh1{font-family:var(--font-display);font-size:1.5rem;margin:0;color:var(--gold);letter-spacing:.5px}\nh1 small{display:block;font-family:var(--font-sans);font-size:var(--text-xs);color:var(--muted-foreground);font-weight:400;letter-spacing:0}\n/* ปุ่มระบบย้ายขึ้นมาบนหัวเรื่อง 8 ก.ย. 2569 — เดิมอยู่ใต้ฉาก ต้องเลื่อนหาทุกครั้ง */\n.sysbtn{display:flex;gap:5px;flex-wrap:wrap;width:100%;justify-content:flex-end}\n.sysbtn button{padding:5px 10px;min-height:0;font-size:var(--text-xs)}\n@media(max-width:820px){.sysbtn{justify-content:flex-start}.sysbtn button{flex:1 1 auto}}\n.chip{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);\n  padding:6px 10px;font-size:var(--text-sm);display:flex;gap:6px;align-items:center;white-space:nowrap}\n.chip b{font-variant-numeric:tabular-nums}\n.bar{width:70px;height:6px;background:var(--muted);border-radius:99px;overflow:hidden}\n.bar i{display:block;height:100%;background:var(--gold)}\n.bar.karma i{background:var(--destructive)}\n.bar.hp i{background:var(--success)}\n\n/* ข้อ D ชุด 13 คุณเป้ 26 ก.ย. 2569 — แถบหิว + ปุ่มป้อนข้